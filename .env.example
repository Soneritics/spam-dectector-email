# --- IMAP Spam Watcher configuration (see specs/001-imap-spam-watcher/contracts/configuration.md) ---

# Incoming (IMAP) mail server
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=spamwatch@example.com
IMAP_PASSWORD=change-me

# Outgoing (SMTP) mail server
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=spamwatch@example.com
SMTP_PASSWORD=change-me

# Sender allow-list (regular expression matched against the From address)
WHITELIST_REGEX=^.*@example\.com$

# Optional semicolon-separated CC list (empty entries ignored)
CC_ADDRESSES=security@example.com;soc@example.com

# Spam Detector Azure Function
DETECTOR_URL=https://spam-detector.azurewebsites.net/spam-check/email
DETECTOR_FUNCTIONS_KEY=change-me
DETECTOR_OPENAI_KEY=change-me
# Optional model override (leave blank to use the detector default)
DETECTOR_MODEL=

# Operational tuning (optional; defaults shown)
POLL_INTERVAL_SECONDS=45
RETRY_MAX_ATTEMPTS=3
RETRY_WINDOW_SECONDS=90
